{
  "name": "alfajar-travel-invoice-generator",
  "version": "1.0.1",
  "description": "Offline desktop invoice generator for Alfajar Travel UK",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "uk.co.alfajartravel.invoicegenerator",
    "productName": "Alfajar Travel Invoice Generator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "alfajar-logo.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "madcraves",
        "repo": "alfajar-travel-invoice-generator",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
